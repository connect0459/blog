---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AuthorBio from '../components/AuthorBio.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_LINKS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { groupByYear, toTimelineEntry } from '../features/timeline/model';

const articles = await getCollection('articles');
const links = await getCollection('links');

const entries = [
	...articles.map((article) =>
		toTimelineEntry({
			type: 'article',
			slug: article.id,
			title: article.data.title,
			pubDate: article.data.pubDate,
		}),
	),
	...links.map((link) =>
		toTimelineEntry({
			type: 'link',
			url: link.data.url,
			title: link.data.title,
			pubDate: link.data.pubDate,
		}),
	),
];

const yearGroups = groupByYear(entries);

const faviconModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/favicons/*.{png,ico,svg,webp,jpg,jpeg}',
	{ eager: true },
);
const faviconsByDomain = new Map(
	Object.entries(faviconModules).map(([path, mod]) => {
		const domain = path
			.split('/')
			.pop()!
			.replace(/\.[^.]+$/, '');
		return [domain, mod.default];
	}),
);
---

<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<AuthorBio links={AUTHOR_LINKS} />
			<div class="timeline">
				{
					yearGroups.map((group) => (
						<div class="year-group">
							<div class="year-label">{group.year}</div>
							{group.entries.map((entry) => {
								const favicon =
									entry.kind === 'external'
										? faviconsByDomain.get(entry.domain)
										: undefined;
								return (
									<a
										class="entry-row"
										href={entry.href}
										target={entry.kind === 'external' ? '_blank' : undefined}
										rel={
											entry.kind === 'external'
												? 'noopener noreferrer'
												: undefined
										}
									>
										{entry.kind === 'native' ? (
											<span
												class="entry-icon entry-icon-internal"
												aria-hidden="true"
											/>
										) : favicon ? (
											<Image
												class="entry-icon entry-favicon"
												src={favicon}
												alt=""
												width={16}
												height={16}
											/>
										) : (
											<span
												class="entry-icon entry-icon-placeholder"
												aria-hidden="true"
											>
												{entry.domain.charAt(0).toUpperCase()}
											</span>
										)}
										<span class="entry-main">
											<span class="entry-title">{entry.title}</span>
											{entry.kind === 'external' && (
												<span class="entry-domain">{entry.domain} ↗</span>
											)}
										</span>
										<span class="entry-date">
											<FormattedDate date={entry.pubDate} format="short" />
										</span>
									</a>
								);
							})}
						</div>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
<style>
	.timeline {
		margin-top: 112px;
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
	}
	.year-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.year-label {
		font-size: 20px;
		font-weight: var(--fw-light);
		letter-spacing: -0.01em;
		margin-bottom: 12px;
	}
	.entry-row {
		display: grid;
		grid-template-columns: 20px minmax(0, 1fr) auto;
		align-items: center;
		gap: 14px;
		padding: 10px 12px;
		margin: 0 -12px;
		font-size: 15px;
		line-height: 1.6;
		background-image: none;
		transition: background var(--dur) var(--ease);
	}
	.entry-row:hover {
		background: var(--surface-container-low);
	}
	.entry-icon {
		width: 16px;
		height: 16px;
		display: block;
	}
	.entry-icon-internal {
		background: var(--on-surface);
	}
	.entry-favicon {
		object-fit: cover;
	}
	.entry-icon-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: var(--fs-caption);
		font-weight: var(--fw-medium);
		color: var(--on-surface);
		background: var(--surface-container);
	}
	.entry-main {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.entry-title {
		text-wrap: pretty;
	}
	.entry-domain {
		font-size: 11px;
		letter-spacing: 0.04em;
		color: var(--tertiary);
	}
	.entry-date {
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		white-space: nowrap;
		color: var(--tertiary);
	}
</style>
