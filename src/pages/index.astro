---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AuthorBio from '../components/AuthorBio.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_LINKS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { groupByYear, toTimelineEntry } from '../features/timeline/model';

const articles = await getCollection('articles');
const links = await getCollection('links');

const entries = [
	...articles.map((article) =>
		toTimelineEntry({
			type: 'article',
			slug: article.id,
			title: article.data.title,
			pubDate: article.data.pubDate,
		}),
	),
	...links.map((link) =>
		toTimelineEntry({
			type: 'link',
			url: link.data.url,
			title: link.data.title,
			pubDate: link.data.pubDate,
		}),
	),
];

const yearGroups = groupByYear(entries);

const faviconModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/favicons/*.{png,ico,svg,webp,jpg,jpeg}',
	{ eager: true },
);
const faviconsByDomain = new Map(
	Object.entries(faviconModules).map(([path, mod]) => {
		const domain = path
			.split('/')
			.pop()!
			.replace(/\.[^.]+$/, '');
		return [domain, mod.default];
	}),
);
---

<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<AuthorBio links={AUTHOR_LINKS} />
			<div class="timeline">
				{
					yearGroups.map((group) => (
						<section class="year-group">
							<h2>{group.year}</h2>
							<ul>
								{group.entries.map((entry) => {
									const favicon =
										entry.kind === 'external'
											? faviconsByDomain.get(entry.domain)
											: undefined;
									return (
										<li>
											<a
												class="entry"
												href={entry.href}
												target={
													entry.kind === 'external' ? '_blank' : undefined
												}
												rel={
													entry.kind === 'external'
														? 'noopener noreferrer'
														: undefined
												}
											>
												{entry.kind === 'native' ? (
													<span class="marker native" aria-hidden="true" />
												) : favicon ? (
													<Image
														class="marker favicon"
														src={favicon}
														alt=""
														width={16}
														height={16}
													/>
												) : (
													<span class="marker placeholder" aria-hidden="true">
														{entry.domain.charAt(0).toUpperCase()}
													</span>
												)}
												<span class="entry-text">
													<span class="title">{entry.title}</span>
													{entry.kind === 'external' && (
														<span class="domain">{entry.domain} ↗</span>
													)}
												</span>
											</a>
											<span class="date">
												<FormattedDate date={entry.pubDate} format="short" />
											</span>
										</li>
									);
								})}
							</ul>
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		display: flex;
		flex-direction: column;
		gap: var(--s-8);
	}
	.timeline {
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
	}
	.year-group h2 {
		margin-bottom: var(--s-3);
	}
	.year-group ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.year-group li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-3);
		padding: var(--s-2) 0;
	}
	.entry {
		display: flex;
		align-items: center;
		gap: var(--s-2);
		min-width: 0;
	}
	.marker {
		flex-shrink: 0;
	}
	.marker.native {
		width: 8px;
		height: 8px;
		background: var(--primary);
	}
	.marker.favicon {
		width: 16px;
		height: 16px;
	}
	.marker.placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 16px;
		font-size: var(--fs-caption);
		font-weight: var(--fw-medium);
		color: var(--on-surface);
		background: var(--surface-container);
	}
	.entry-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.domain {
		font-size: var(--fs-caption);
		letter-spacing: var(--tr-caption);
		color: var(--tertiary);
	}
	.date {
		flex-shrink: 0;
		font-size: var(--fs-caption);
		letter-spacing: var(--tr-caption);
		color: var(--secondary);
	}
</style>
