---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<p>&copy; {year} {SITE_TITLE}</p>
</footer>
<style>
	footer {
		padding: var(--s-5) 0 var(--s-6) 0;
	}
	p {
		width: 680px;
		max-width: calc(100% - 2em);
		margin: auto;
		font-size: var(--fs-caption);
		letter-spacing: var(--tr-caption);
		color: var(--secondary);
	}
</style>
