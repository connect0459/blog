---
import { formatFullDate, formatShortDate } from '../features/timeline/model';

interface Props {
	date: Date;
	format?: 'full' | 'short';
}

const { date, format = 'full' } = Astro.props;
const display =
	format === 'short' ? formatShortDate(date) : formatFullDate(date);
---

<time datetime={date.toISOString()}>{display}</time>
