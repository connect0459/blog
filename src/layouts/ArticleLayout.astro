---
import type { CollectionEntry } from 'astro:content';
import AuthorBio from '../components/AuthorBio.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import type { NativeTimelineEntry } from '../features/timeline/model';

type Props = CollectionEntry<'articles'>['data'] & {
	prev: NativeTimelineEntry | null;
	next: NativeTimelineEntry | null;
};

const { title, description, pubDate, updatedDate, heroImage, prev, next } =
	Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<a href="/" class="back-link">← 一覧</a>
			<article>
				<div class="meta">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="updated">
								（更新: <FormattedDate date={updatedDate} />）
							</span>
						)
					}
				</div>
				<h1>{title}</h1>
				<div class="prose">
					<slot />
				</div>
			</article>
			<AuthorBio />
			<nav class="adjacent" aria-label="記事ナビゲーション">
				<div class="prev">
					{
						prev && (
							<a href={prev.href}>
								<span class="label">← 前の記事</span>
								<span class="title">{prev.title}</span>
							</a>
						)
					}
				</div>
				<div class="next">
					{
						next && (
							<a href={next.href}>
								<span class="label">次の記事 →</span>
								<span class="title">{next.title}</span>
							</a>
						)
					}
				</div>
			</nav>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		display: flex;
		flex-direction: column;
		gap: var(--s-7);
	}
	.back-link {
		font-size: var(--fs-label);
		letter-spacing: var(--tr-label);
		color: var(--secondary);
	}
	.meta {
		margin-bottom: var(--s-2);
		font-size: var(--fs-label);
		letter-spacing: var(--tr-label);
		color: var(--secondary);
	}
	.updated {
		margin-left: var(--s-2);
	}
	article h1 {
		margin-bottom: var(--s-5);
	}
	.adjacent {
		display: flex;
		justify-content: space-between;
		gap: var(--s-3);
		padding-top: var(--s-5);
		border-top: 1px solid var(--outline);
	}
	.adjacent a {
		display: flex;
		flex-direction: column;
		gap: var(--s-1);
	}
	.next {
		text-align: right;
	}
	.next a {
		align-items: flex-end;
	}
	.label {
		font-size: var(--fs-caption);
		letter-spacing: var(--tr-caption);
		color: var(--secondary);
	}
</style>
